# Required for local application runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
SESSION_PASSWORD="replace-with-a-unique-random-secret-at-least-32-characters-long"

# Required for Admin banner and product image uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Optional one-time Admin bootstrap credentials. Never commit real values.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="Use-a-unique-password-12-plus-characters-and-no-more-than-72-UTF8-bytes"
